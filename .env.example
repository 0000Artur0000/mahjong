POSTGRES_DB=dorahub
POSTGRES_USER=dorahub
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
BACKEND_PORT=8080

# Required in production; inject real values from the deployment secret store.
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_URL=jdbc:postgresql://postgres.example:5432/dorahub
# DATABASE_USER=dorahub
# DATABASE_PASSWORD=replace-me
# PUBLIC_BASE_URL=https://dorahub.example.com
# TELEGRAM_OIDC_CLIENT_ID=replace-me
# TELEGRAM_OIDC_CLIENT_SECRET=replace-me
# VK_ID_CLIENT_ID=replace-me
# VK_ID_CLIENT_SECRET=replace-me
# TOTP_ENCRYPTION_KEY=base64-encoded-32-byte-key
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=replace-me
# SMTP_PASSWORD=replace-me
# SMTP_FROM=no-reply@example.com
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=replace-me
# S3_BUCKET=dorahub
# S3_ACCESS_KEY=replace-me
# S3_SECRET_KEY=replace-me
# VISION_BASE_URL=https://vision.example.com
# VISION_API_KEY=replace-me

# Optional telemetry export; leave disabled until an OTLP Collector is available.
# OTEL_EXPORT_ENABLED=false
# OTEL_TRACES_ENDPOINT=http://collector:4318/v1/traces
# OTEL_METRICS_URL=http://collector:4318/v1/metrics
