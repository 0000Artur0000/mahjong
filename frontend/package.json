{
  "name": "dorahub-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../contracts/openapi/api.yaml -o src/api/schema.d.ts",
    "predev": "npm run gen:api",
    "dev": "vite",
    "prebuild": "npm run gen:api",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/bundle-report.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "npm run gen:api",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run gen:api",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:tiles": "node scripts/tiles/build.mjs",
    "assets:fonts": "node scripts/fonts/build.mjs",
    "assets:icons": "node scripts/icons/build.mjs",
    "assets": "npm run assets:tiles && npm run assets:fonts && npm run assets:icons",
    "contract:check": "node scripts/contract-check.mjs",
    "analyze": "node scripts/bundle-report.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run contract:check && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.0",
    "lucide-react": "^1.27.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.0.0",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
